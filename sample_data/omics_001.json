        "type": { "id": "Created" }
      }
    ],
    "languages": [{ "id": "ENG" }],

    "omics_type": ["genomics"],
    "sensitivity_class": "nonsensitive",

    "biological_material": [
      {
        "material_type": "human",
        "sample_id": "P001-T",
        "tissue": "primary tumour",
