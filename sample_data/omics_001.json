    "additional_descriptions": [
      {
        "lang": { "id": "ENG" },
        "type": { "id": "abstract" },
        "description": "Pilot whole-genome sequencing dataset from a single patient (tumour and matched normal). Illumina NovaSeq 6000, paired-end 150 bp. Aligned to GRCh38 with BWA-MEM2, variants called with GATK HaplotypeCaller. Intended as a demo record covering the CCMM core plus the OmiCZ metadata extension (biological material → sequencing → data processing lineage)."
      }
    ],
