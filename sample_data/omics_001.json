      }
    ],

    "sequencing": {
      "platform": "Illumina NovaSeq 6000",
      "library_strategy": "WGS",
      "library_selection": "RANDOM",
      "library_source": "GENOMIC",
      "read_layout": "paired",
      "read_length": 150,
      "target_coverage_x": 30,
      "library_prep_kit": "Illumina TruSeq DNA PCR-Free",
      "run_date": "2026-04-22"
    },

    "data_processing": [
      {
        "step": 1,
        "name": "Adapter trimming",
        "software": "fastp",
        "version": "0.23.4",
        "parameters": { "--length_required": 50 }
      },
      {
        "step": 2,
        "name": "Alignment to reference",
        "software": "bwa-mem2",
        "version": "2.2.1",
        "reference": {
          "assembly": "GRCh38",
          "source": "GATK Resource Bundle"
        },
        "input_type": "fastq",
        "output_type": "bam"
      },
      {
        "step": 3,
        "name": "Duplicate marking",
        "software": "GATK MarkDuplicates",
        "version": "4.5.0.0"
      },
      {
        "step": 4,
        "name": "Germline variant calling",
        "software": "GATK HaplotypeCaller",
        "version": "4.5.0.0",
        "workflow": "https://github.com/gatk-workflows/gatk4-germline-snps-indels",
        "input_type": "bam",
        "output_type": "vcf"
      }
    ]
